rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 로그인 여부 확인
    function isLoggedIn() {
      return request.auth != null;
    }
    // 관리자 확인
    function isAdmin() {
      return request.auth.token.email == 'junbsd@gmail.com';
    }
    // 승인된 사용자 확인
    function isApproved() {
      return isAdmin() || (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != 'blocked'
      );
    }
    // 공유 사용자 확인
    function isShared() {
      return isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'shared';
    }
    // users 컬렉션 - 본인 데이터 읽기/쓰기, 관리자는 전체
    match /users/{userId} {
      allow read: if isLoggedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isLoggedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
    }
    // teams 컬렉션 - 승인된 사용자는 읽기 가능, 관리자만 쓰기(추가/수정/삭제) 가능
    match /teams/{teamId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }
    // works 컬렉션
    match /works/{workId} {
      allow read: if isApproved();
      allow write: if isApproved();
    }
    // expenses 컬렉션
    match /expenses/{expenseId} {
      allow read: if isApproved();
      allow write: if isApproved();
    }

    match /opinions/{opinionId} {
      allow read, write: if isApproved();
    }

    match /estimates/{estimateId} {
      allow read, write: if isApproved();
    }
    // detailedEstimates(세부견적서) - 공유·팀·개인 구분 없이 승인된 모든 사용자가 함께 읽고 쓴다
    match /detailedEstimates/{estimateId} {
      allow read, write: if isApproved();
    }
    // receipts(간이영수증) - 세부견적서와 동일하게 승인된 모든 사용자가 함께 읽고 쓴다
    match /receipts/{receiptId} {
      allow read, write: if isApproved();
    }
    // workerDirectory - 세부견적서 작성 시 "다른 사용자 선택"을 위한 공개용 최소 정보
    // (이름·업체명·전화번호·서명 등만 있고, 이메일·승인상태 등 민감정보는 없음)
    match /workerDirectory/{userId} {
      allow read: if isApproved();
      allow write: if isLoggedIn() && (request.auth.uid == userId || isAdmin());
    }
    // clients, equipment - 승인된 사용자만
    match /clients/{id} {
      allow read, write: if isApproved();
    }
    match /equipment/{id} {
      allow read, write: if isApproved();
    }
  }
}
